{
  "name": "forgecord-bot",
  "version": "1.0.0",
  "description": "A Forgecord Discord bot (TypeScript)",
  "main": "dist/bot.js",
  "scripts": {
    "dev": "tsx watch bot.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bot.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "discord.js": "latest",
    "chalk": "^4.1.2",
    "ascii-table": "^0.0.9",
    "boxen": "^5.1.2",
    "gradient-string": "^2.0.2",
    "dotenv": "latest",
    "winston": "latest",
    "winston-daily-rotate-file": "latest",
    "systeminformation": "latest",
    "@logtail/winston": "latest",
    "@logtail/node": "latest",
    "express": "latest",
    "ms": "^2.1.3",
    "good.db": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsx": "^4.7.2",
    "@types/node": "^20.11.30",
    "@types/gradient-string": "^1.1.6",
    "vitest": "^2.1.1",
    "@types/express": "^5.0.0",
    "@types/ms": "^2.1.0"
  }
}
