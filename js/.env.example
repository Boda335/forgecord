#
#  Forgecord Environment Configuration
# ====================================================================================

# Your Discord Bot Token
TOKEN=

# Command prefix for your bot (e.g., !, $, ?)
PREFIX=!

# Client ID of your bot (found in Discord Developer Portal)
ID=CLIENT_ID

# Comma-separated Discord user IDs allowed to use owner-only commands (empty by default)
OWNER_IDS=

# Optional links/labels; leave blank to disable personal defaults
SUPPORT_SERVER_URL=
DEVELOPER_URL=
DEVELOPER_LABEL=Bot Developer
DEVELOPER_TEAM_LABEL=Development Team
STORE_URL=
SLASH_GUILD_IDS=


# Encryption key for sensitive data (keep this secret!)
REMEMBER_ENCRYPTION_KEY=your_encryption_key_here

# Environment mode (development or production)
NODE_ENV=development

# Logtail configuration (optional)
LOGTAIL_ENABLE=false

# Logtail source token (if LOGTAIL_ENABLE is true)
LOGTAIL_SOURCE_TOKEN=

# Logtail ingestion host (if LOGTAIL_ENABLE is true)
LOGTAIL_INGESTION_HOST=

# Forgecord Dashboard (enabled automatically when generated with --dashboard)
DASHBOARD_ENABLED=false
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0

# Discord OAuth for the Forgecord Dashboard
# Use your Discord application client secret. Never expose this value in frontend code.
DISCORD_CLIENT_SECRET=
DASHBOARD_URL=
# Optional: explicitly set this when your public callback URL differs from the default.
DASHBOARD_REDIRECT_URI=
# Set true only when the dashboard is served over HTTPS.
DASHBOARD_COOKIE_SECURE=false
# Automatically build dashboard/dist when it is missing in development.
DASHBOARD_AUTO_BUILD=true
